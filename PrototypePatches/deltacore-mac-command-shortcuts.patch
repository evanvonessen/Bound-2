+    // UIKit handles desktop Command shortcuts independently of GCKeyboard. Do not
+    // also send those keys to the emulator, even when a user maps 1/2/3 to inputs.
+    // Release preexisting holds on Command-down so a swallowed key-up cannot stick.
+    internal func processKey(_ input: Input, isActive: Bool, commandHeld: Bool,
+                             isRunningOnMac: Bool = ProcessInfo.processInfo.isiOSAppOnMac)
+    {
+        if isRunningOnMac && (commandHeld || input == .command)
+        {
+            for active in self.activatedInputs.keys { self.deactivate(active) }
+            return
